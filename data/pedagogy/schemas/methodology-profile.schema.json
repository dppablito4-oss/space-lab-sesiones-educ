{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesiones.sypablitodp.site/schemas/methodology-profile-v1.json",
  "title": "Space Lab MethodologyProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileVersion", "id", "code", "displayName", "description", "status", "suitableLevels", "recommendedPhases", "fieldRules", "sequenceRules", "assessmentRecommendations", "promptRules", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profileVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]+$" },
    "id": { "$ref": "#/$defs/id" },
    "code": { "enum": ["project_based_learning", "problem_based_learning", "challenge_based_learning", "game_based_learning", "custom"] },
    "displayName": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "status": { "enum": ["draft", "pilot", "reviewed", "archived"] },
    "suitableLevels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["initial", "primary", "secondary"] } },
    "recommendedPhases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "purpose", "mode"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" },
          "purpose": { "$ref": "#/$defs/text" },
          "mode": { "const": "recommended" }
        }
      }
    },
    "fieldRules": { "$ref": "#/$defs/rules" },
    "sequenceRules": { "$ref": "#/$defs/rules" },
    "assessmentRecommendations": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "promptRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prioritize", "avoid"],
      "properties": {
        "prioritize": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "avoid": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRefs", "reviewNote"],
      "properties": {
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "reviewNote": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "operator", "severity", "message"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/text" },
          "operator": { "enum": ["non_empty", "sequence_type_present", "milestone_phase_present", "milestone_partial_product_present", "always"] },
          "value": { "type": "string" },
          "severity": { "enum": ["warning", "suggestion"] },
          "message": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}

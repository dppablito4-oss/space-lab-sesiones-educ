{
  "name": "space-lab-ui-preview",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:public:assets": "tsc -p react-ui/tsconfig.json --noEmit && vite build --config react-ui/vite.public.config.mts",
    "build:public": "npm run build:public:assets && npm run build:admin && python scripts/build_index.py --write && python scripts/build_admin.py --write && python scripts/version_assets.py --write",
    "build:admin": "tsc -p react-ui/tsconfig.json --noEmit && vite build --config react-ui/vite.admin.config.mts",
    "test:admin:db": "node tests/admin_database.test.mjs",
    "dev:react": "vite --config react-ui/vite.config.mts",
    "build:react": "tsc -p react-ui/tsconfig.json --noEmit && vite build --config react-ui/vite.config.mts",
    "preview:react": "vite preview --config react-ui/vite.config.mts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
